class Solution {
    public String reverseWords(String s) {
        StringBuilder ans = new StringBuilder();
        int i = s.length() - 1;

        while (i >= 0) {

            // Skip spaces
            while (i >= 0 && s.charAt(i) == ' ')
                i--;

            if (i < 0)
                break;

            int end = i;

            // Find beginning of word
            while (i >= 0 && s.charAt(i) != ' ')
                i--;

            ans.append(s.substring(i + 1, end + 1));

            // Add space if more words remain
            while (i >= 0 && s.charAt(i) == ' ')
                i--;

            if (i >= 0)
                ans.append(" ");
        }

        return ans.toString();
    }
}

