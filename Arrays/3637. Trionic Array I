class Solution {
    public boolean isTrionic(int[] nums) {
        int n = nums.length;
        int i = 0;

        // Increasing
        while (i + 1 < n && nums[i] < nums[i + 1]) i++;
        int p = i;
        if (p == 0) return false;

        // Decreasing
        while (i + 1 < n && nums[i] > nums[i + 1]) i++;
        int q = i;
        if (q == p || q == n - 1) return false;

        // Increasing again
        while (i + 1 < n && nums[i] < nums[i + 1]) i++;

        return i == n - 1;
    }
}
