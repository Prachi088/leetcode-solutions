class Solution {
    public long maxSumTrionic(int[] nums) {
        int n = nums.length;
        long ans = Long.MIN_VALUE;

        int l = 0;

        while (l < n - 3) {
            int i = l;
            long sum = nums[i];

            // 1) strictly increasing
            while (i + 1 < n && nums[i] < nums[i + 1]) {
                i++;
                sum += nums[i];
            }
            int p = i;

            // need at least one increase
            if (p == l) {
                l++;
                continue;
            }

            // 2) strictly decreasing
            while (i + 1 < n && nums[i] > nums[i + 1]) {
                i++;
                sum += nums[i];
            }
            int q = i;

            // need at least one decrease
            if (q == p) {
                l = p;
                continue;
            }

            // 3) strictly increasing again
            while (i + 1 < n && nums[i] < nums[i + 1]) {
                i++;
                sum += nums[i];
                ans = Math.max(ans, sum);
            }

            // move l forward to avoid O(n^2)
            l = Math.max(l + 1, p);
        }

        return ans;
    }
}
